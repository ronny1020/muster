{
  "name": "muster",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A terminal built for AI agent CLIs: tabs that know which agent they run, and a review panel for what it changed.",
  "license": "Apache-2.0",
  "keywords": [
    "terminal",
    "tauri",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "goose",
    "openclaw",
    "hermes",
    "aider",
    "antigravity",
    "pty",
    "xterm",
    "code-review",
    "diff",
    "markdown-preview",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "serve": "bun --port 1420 ./index.html",
    "bundle": "bun run build.ts",
    "check": "tsc --noEmit",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo check --all-targets && cargo clippy --all-targets -- -D warnings && cargo test --lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "bun run check && bun run format:check && bun test && bun run check:rust",
    "test": "bun test",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0"
  }
}
