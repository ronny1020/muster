{
  "name": "muster",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Run AI agent CLIs in Chrome-style tabs, each a real terminal with its own directory and git state.",
  "license": "MIT",
  "keywords": [
    "terminal",
    "tauri",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "pty",
    "xterm",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "serve": "bun --port 1420 ./index.html",
    "bundle": "bun run build.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0"
  }
}
